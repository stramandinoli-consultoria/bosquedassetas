<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Setas.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
  </ItemGroup>

  <!-- As 300 fases curadas vão dentro da DLL (mesmo arquivo do jogo: src/data/levels.json) -->
  <ItemGroup>
    <Content Remove="Data/levels.json" />
    <EmbeddedResource Include="Data/levels.json" LogicalName="levels.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Setas.Tests" />
  </ItemGroup>

</Project>
