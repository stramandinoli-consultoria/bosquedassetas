{
  "name": "setas-puzzle",
  "version": "2.0.0",
  "private": true,
  "description": "Setas! — puzzle de tirar setas do tabuleiro (web, PWA, Android e iOS)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "levels": "tsx scripts/generate-levels.ts && tsx scripts/export-vectors.ts",
    "build:single": "node scripts/build-single.mjs",
    "icons": "capacitor-assets generate",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "vectors": "tsx scripts/export-vectors.ts",
    "mock-api": "tsx scripts/mock-api.ts",
    "api": "dotnet run --project server/Setas.Api",
    "api:test": "dotnet test server/Setas.Tests"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@fontsource/lilita-one": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
